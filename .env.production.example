NODE_ENV=production
PORT=8000

APP_NAME=FastFood
FRONTEND_URL=https://your-frontend-domain.com
LIMIT_PAGE=10
MAX_DELIVERY_DISTANCE=10

DB_DIALECT=postgres
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=fastfood
DB_PASSWORD=change_me_strong_password
DB_NAME=fastfood
DB_SSL=false
DB_SYNCHRONIZE=false
DB_MAX_CONN=10

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

JWT_SECRET=change_me_jwt_secret
JWT_SCRECT=change_me_jwt_secret
JWT_RESET_SECRET=change_me_reset_secret
JWT_EXPIRESIN=7d

MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_TLS_REJECT_UNAUTHORIZED=true
MAIL_USER=your-mail-user
MAIL_PASSWORD=your-mail-password
MAIL_DEFAULT_NAME=FastFood
MAIL_DEFAULT_EMAIL=no-reply@example.com
SUPPORT_EMAIL=support@example.com
COMPANY_ADDRESS=Your company address
COMPANY_PHONE=0000000000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.your-domain.com/api/v1/auth/google/callback

GOONG_API_KEY=
STORE_LATITUDE=0
STORE_LONGITUDE=0

SEPAY_ACCOUNT_NAME=
SEPAY_ACCOUNT_NUMBER=
SEPAY_API_TOKEN=
SEPAY_BANK_CODE=
SEPAY_POLLING_ENABLED=false
